server:
  host: "127.0.0.1"
  port: 5609

backends:
  agent_bus:
    url: "http://127.0.0.1:7490"
    gateway_token_file: "/data/ronin/secrets/ronin-mcp.token"
  work_folder:
    # MCP client connects to katana-work-folder MCP (streamable-http).
    mcp_url: "http://127.0.0.1:5605/mcp"

auth:
  prod_write_enabled: false  # default false; require explicit --prod-write or RONIN_PROD_WRITE=1
  ephemeral: false           # set true with --ephemeral
